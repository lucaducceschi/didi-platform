# Copy to .env to override the defaults for local development.
# The default password below is for the local Docker database only.
DIDI_DATABASE_URL=postgresql+psycopg://didi:didi_dev@localhost:5433/didi
# Path to the corpus file. Defaults to data/processed/didi_corpus.db in this repository.
# DIDI_CORPUS_PATH=/absolute/path/to/didi_corpus.db
DIDI_BUILD_VERSION=dev
# Set to true anywhere the app is served over HTTPS.
DIDI_COOKIE_SECURE=false
